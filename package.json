{
  "name": "vscode-muse-chat",
  "displayName": "Muse Chat (LaTeX)",
  "description": "VS Code webview chat for Muse Code (Meta Muse Spark) with Markdown + LaTeX (KaTeX) rendering",
  "version": "0.1.1",
  "publisher": "archil-l",
  "engines": {
    "vscode": "^1.80.0"
  },
  "categories": [
    "Other"
  ],
  "main": "./out/extension.js",
  "contributes": {
    "commands": [
      {
        "command": "vscode-muse-chat.openChat",
        "title": "Muse Chat: Open Chat (LaTeX)"
      }
    ],
    "viewsContainers": {
      "activitybar": [
        {
          "id": "muse-chat",
          "title": "Muse",
          "icon": "$(comment-discussion)"
        }
      ]
    },
    "views": {
      "muse-chat": [
        {
          "type": "webview",
          "id": "vscode-muse-chat.chatView",
          "name": "Chat (LaTeX)"
        }
      ]
    }
  },
  "astryx": {
    "theme": "neutral"
  },
  "scripts": {
    "vscode:prepublish": "npm run compile",
    "compile": "tsc -p ./",
    "typecheck": "tsc -p ./ --noEmit && tsc -p webview/tsconfig.json --noEmit",
    "typecheck:extension": "tsc -p ./ --noEmit",
    "typecheck:webview": "tsc -p webview/tsconfig.json --noEmit",
    "build:webview": "vite build --config webview/vite.config.ts",
    "build": "npm run typecheck && npm run build:webview && npm run compile",
    "watch": "tsc -watch -p ./",
    "watch:webview": "vite build --config webview/vite.config.ts --watch",
    "lint": "eslint src --ext ts"
  },
  "devDependencies": {
    "@types/node": "20.x",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.7",
    "@types/vscode": "^1.80.0",
    "typescript": "^5.4.0"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/archil-l/vscode-muse-chat"
  },
  "dependencies": {
    "@astryxdesign/cli": "^0.5.4",
    "@astryxdesign/core": "^0.5.4",
    "@astryxdesign/theme-neutral": "^0.5.4",
    "@heroicons/react": "^2.2.0",
    "@stylexjs/stylex": "^0.19.0",
    "@vitejs/plugin-react": "^4.7.0",
    "katex": "^0.16.47",
    "marked": "^14.1.4",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "vite": "^6.4.3"
  },
  "activationEvents": [
    "onStartupFinished"
  ]
}
